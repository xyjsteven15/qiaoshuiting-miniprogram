/* ========= 桥水汀 · 全局主题（官方 logo 墨色版）=========
   素纸中性底 + 黛墨控件，取色自官方 logo：
   墨（书法）/ 朱砂（印章，仅小面积点缀）/ 铜金（东方味来）
   衬线（Lora / 宋体）标题 + 无衬线（Geist / 系统）正文
*/

page {
  --paper: #EFF0EC;        /* 素纸底（中性微凉，不橙） */
  --card: #FFFFFF;         /* 卡片白 */
  --banner: #F6F7F3;       /* 浅素横幅 */
  --ink: #292B26;          /* 主文字 墨色 */
  --ink-soft: #64665E;     /* 次级文字 灰墨 */
  --muted: #9CA093;        /* 弱化文字 */
  --accent: #262A24;       /* 黛墨 · 主操作/强调 */
  --accent-deep: #1B1E19;  /* 黛墨加深 · 按压态 */
  --brand-red: #9E3B32;    /* 桥 · 朱砂（取印章色，深而不橙） */
  --brand-teal: #4E7672;   /* 水 · 黛青（加深） */
  --brand-olive: #8A6D3F;  /* 汀 · 铜金（取「东方味来」） */
  --rose: #7FA8A4;         /* 黛青软色 */
  --rose-bg: #E9F0EE;      /* 黛青浅底 */
  --wood: #5C5648;         /* 胡桃木（去暖） */
  --line: #DBDBD2;         /* 描边/分隔 */
  --ok: #2E7D32;           /* 可预订绿 */
  --ok-bg: #E2F0D9;

  background-color: var(--paper);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Geist", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 衬线字：标题、品牌、中文大字 */
.serif {
  font-family: "Lora", "Songti SC", "STSong", "SimSun", serif;
}

.ink { color: var(--ink); }
.soft { color: var(--ink-soft); }
.muted { color: var(--muted); }
.accent { color: var(--accent); }

/* 屏内页头：居中标题 + 英文副标 + 短线 */
.screen-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 48rpx;
}
.screen-header .sh-title {
  font-size: 40rpx;
  letter-spacing: 2rpx;
  color: var(--ink);
  font-weight: 600;
}
.screen-header .sh-sub {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.screen-header .sh-line {
  width: 80rpx;
  height: 3rpx;
  background: var(--brand-red);
  margin-top: 20rpx;
}

/* 段标签：绛红小竖条 + 衬线小标题 */
.label {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.label .tick {
  width: 6rpx;
  height: 24rpx;
  background: var(--brand-red);
}
.label .label-txt {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
}

/* 主按钮：墨色底白字 */
.btn-primary {
  background: var(--accent);
  color: #FFFFFF;
  border-radius: 8rpx;
  text-align: center;
  padding: 28rpx 0;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  font-family: "Lora", "Songti SC", serif;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(27, 30, 25, 0.28);
}
.btn-primary.disabled { opacity: 0.45; }

/* 次按钮：白底墨色描边 */
.btn-secondary {
  background: #FFFFFF;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 8rpx;
  text-align: center;
  padding: 28rpx 0;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  font-family: "Lora", "Songti SC", serif;
  font-weight: 600;
}

/* 卡片 */
.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 6rpx 28rpx rgba(38, 42, 36, 0.06);
}

/* 推荐/标记印章 */
.badge-accent {
  display: inline-block;
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--accent);
  border-radius: 4rpx;
  padding: 4rpx 14rpx;
  font-family: "Lora", "Songti SC", serif;
}
.badge-ok {
  display: inline-block;
  font-size: 20rpx;
  color: var(--ok);
  background: var(--ok-bg);
  border-radius: 4rpx;
  padding: 4rpx 14rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--line);
}
.divider-dash {
  height: 0;
  border-top: 1rpx dashed var(--line);
}

/* 缓入 */
@keyframes floorIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.floor-in { animation: floorIn 380ms ease-out both; }
