<view class="tabbar">
  <view class="tabbar-line"></view>
  <view
    class="tab"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab">
    <image class="tab-icon" src="{{selected === index ? item.iconOn : item.icon}}"></image>
    <text class="tab-text {{selected === index ? 'on' : ''}}">{{item.text}}</text>
  </view>
</view>
