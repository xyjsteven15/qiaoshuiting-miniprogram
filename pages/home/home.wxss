.home {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

/* 顶部：品牌图 + 内景图 + 融入底色的柔化蒙版 */
.hero-wrap {
  position: relative;
}
.brand-logo {
  width: 100%;
  display: block;
}
.hero {
  width: 100%;
  height: 480rpx;
  display: block;
}
.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 130rpx;
  background: linear-gradient(180deg, rgba(245, 240, 232, 0) 0%, var(--paper) 100%);
}

/* 品牌介绍区（含淡雅水印） */
.intro-wrap {
  position: relative;
  overflow: hidden;
  padding-top: 12rpx;
}
.watermark {
  position: absolute;
  right: -30rpx;
  top: -80rpx;
  font-size: 400rpx;
  line-height: 1;
  color: rgba(139, 37, 0, 0.045);
  pointer-events: none;
}
.ornament {
  display: block;
  width: 280rpx;
  height: 28rpx;
  margin: 28rpx auto 0;
}

.brand-intro {
  padding: 20rpx 48rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

/* 品牌名 + 两侧翼纹 */
.brand-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 8rpx;
}
.wing {
  width: 60rpx;
  height: 1rpx;
  background: var(--accent);
  opacity: 0.5;
  position: relative;
}
.wing::after {
  content: '';
  position: absolute;
  top: -3rpx;
  width: 7rpx;
  height: 7rpx;
  background: var(--accent);
  transform: rotate(45deg);
}
.wing.left::after { right: 0; }
.wing.right::after { left: 0; }

.brand-name {
  font-size: 50rpx;
  letter-spacing: 16rpx;
  color: var(--ink);
  font-weight: 500;
  text-indent: 16rpx;
}
.brand-en {
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: var(--ink-soft);
  margin-top: 16rpx;
}

/* 诗意分隔 */
.poetry {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 30rpx 0;
}
.poetry .p-line {
  width: 44rpx;
  height: 1rpx;
  background: var(--muted);
}
.poetry .p-diamond {
  width: 8rpx;
  height: 8rpx;
  background: var(--accent);
  transform: rotate(45deg);
}
.poetry .p-word {
  font-size: 24rpx;
  color: var(--accent);
  font-style: italic;
  letter-spacing: 4rpx;
}

.brand-desc {
  font-size: 30rpx;
  line-height: 1.95;
  letter-spacing: 2rpx;
  color: var(--ink);
  text-align: center;
}

/* 底部行动区 */
.cta-wrap {
  padding: 24rpx 48rpx calc(96rpx + env(safe-area-inset-bottom));
  margin-top: auto;
}
.cta-sub {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 28rpx;
}
.cta-sub .cs-line {
  width: 40rpx;
  height: 1rpx;
  background: var(--muted);
  opacity: 0.6;
}
.cta-sub .cs-word {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--muted);
}
.hover { opacity: 0.88; }
