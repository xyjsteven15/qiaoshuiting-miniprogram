.home {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ===== 门面头图 ===== */
.hero-wrap {
  position: relative;
}
.hero {
  width: 100%;
  height: 460rpx;
  display: block;
}
/* 底部轻压暗，让照片与叠卡衔接更沉稳 */
.hero-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(27, 30, 25, 0) 55%, rgba(27, 30, 25, 0.28) 100%);
}
/* 最底缘融入纸色 */
.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60rpx;
  background: linear-gradient(180deg, rgba(239, 240, 236, 0) 0%, var(--paper) 100%);
}

/* ===== 品牌卡（上叠头图） ===== */
.brand-card {
  margin: -110rpx 48rpx 0;
  padding: 44rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
  border-radius: 20rpx;
}
.brand-logo {
  width: 380rpx;
  margin-bottom: 30rpx;
}
.brand-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.wing {
  width: 60rpx;
  height: 1rpx;
  background: var(--brand-red);
  opacity: 0.5;
  position: relative;
}
.wing::after {
  content: '';
  position: absolute;
  top: -3rpx;
  width: 7rpx;
  height: 7rpx;
  background: var(--brand-red);
  transform: rotate(45deg);
}
.wing.left::after { right: 0; }
.wing.right::after { left: 0; }

.brand-slogan {
  font-size: 28rpx;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  color: var(--accent);
  white-space: nowrap;
}

/* ===== 桥水汀 · 三字笺 ===== */
.triad-card {
  margin: 36rpx 48rpx 0;
  padding: 40rpx 24rpx;
  display: flex;
  align-items: center;
  border-radius: 20rpx;
}
.triad-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.triad-char {
  font-size: 64rpx;
  line-height: 1.15;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.c-red { color: var(--brand-red); }
.c-teal { color: var(--brand-teal); }
.c-olive { color: var(--brand-olive); }
.triad-line {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  text-indent: 4rpx;
  line-height: 1.9;
  color: var(--ink-soft);
}
.triad-sep {
  width: 1rpx;
  height: 128rpx;
  background: var(--line);
}

/* ===== 典故入口卡 ===== */
.story-card {
  margin: 36rpx 48rpx 0;
  padding: 36rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}
.story-txt {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.story-sub {
  font-size: 32rpx;
  line-height: 2;
  letter-spacing: 2rpx;
  color: var(--ink-soft);
  margin-top: 20rpx;
}
.story-more {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--accent);
  letter-spacing: 2rpx;
}
.story-arrow {
  font-size: 26rpx;
}

/* ===== 空间一览 ===== */
.space-wrap {
  padding: 44rpx 48rpx 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.space-label {
  margin-bottom: 4rpx;
}
.space-card {
  border-radius: 20rpx;
  overflow: hidden;
}
.space-img {
  width: 100%;
  height: 260rpx;
  display: block;
}
.space-img.lg {
  height: 320rpx;
}
.space-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}
.space-names {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}
.space-name {
  font-size: 34rpx;
  letter-spacing: 4rpx;
  color: var(--ink);
  font-weight: 600;
}
.space-note {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
}

/* ===== 底部行动区 ===== */
.cta-wrap {
  padding: 48rpx 48rpx 0;
  margin-top: auto;
}
.cta-sub {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 28rpx;
}
.cta-sub .cs-line {
  width: 40rpx;
  height: 1rpx;
  background: var(--muted);
  opacity: 0.6;
}
.cta-sub .cs-word {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--muted);
}
.hover { opacity: 0.88; }
