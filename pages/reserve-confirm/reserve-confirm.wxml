<view class="confirm">
  <view class="screen-header">
    <text class="sh-title serif">确认预订</text>
    <text class="sh-sub">CONFIRM BOOKING</text>
    <view class="sh-line"></view>
  </view>

  <view class="body floor-in">
    <!-- 预订概要 -->
    <view class="card summary">
      <view class="label"><view class="tick"></view><text class="label-txt serif">预订概要</text></view>
      <view class="divider-dash"></view>
      <view class="grid">
        <view class="row"><text class="k">用餐日期</text><text class="v serif">{{summary.dateText}}</text></view>
        <view class="row"><text class="k">用餐时间</text><text class="v">{{summary.time}}</text></view>
        <view class="row"><text class="k">用餐人数</text><text class="v">{{summary.guests}}人</text></view>
        <view class="row"><text class="k">包厢类型</text><text class="v accent serif">{{summary.tierText}}</text></view>
      </view>
    </view>

    <!-- 联系人信息 -->
    <view class="contact">
      <view class="label"><view class="tick"></view><text class="label-txt serif">联系人信息</text></view>

      <view class="field">
        <text class="f-label">联系人姓名</text>
        <input class="f-input" placeholder="请输入联系人姓名" placeholder-class="ph" value="{{name}}" bindinput="onName" />
      </view>

      <view class="field">
        <text class="f-label">手机号码</text>
        <input class="f-input" type="number" maxlength="11" placeholder="请输入手机号码" placeholder-class="ph" value="{{phone}}" bindinput="onPhone" />
      </view>

      <view class="field">
        <text class="f-label">特殊需求/备注</text>
        <textarea class="f-textarea" placeholder="如有忌口、过敏等特殊要求请注明" placeholder-class="ph" value="{{note}}" bindinput="onNote" maxlength="120" />
      </view>
    </view>
  </view>

  <view class="action">
    <view class="btn-primary" hover-class="hover" bindtap="submit">确认预订</view>
  </view>
</view>
