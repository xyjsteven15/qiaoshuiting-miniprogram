<view class="room-sel">
  <view class="screen-header">
    <text class="sh-title serif">选择包厢</text>
    <text class="sh-sub">SELECT ROOM</text>
    <view class="sh-line"></view>
  </view>

  <view class="banner">
    <text class="banner-dot">◈</text>
    <text class="banner-txt">{{banner}}</text>
  </view>

  <view class="rooms floor-in">
    <!-- 开放座位区：卡座与室外座位各自独立分组；卡座内 4/6 人位桌合并为一张卡 -->
    <block wx:for="{{areas}}" wx:key="key">
      <view class="opt-label">
        <view class="tick"></view><text class="label-txt serif">{{item.label}}</text>
      </view>
      <view
        class="room-card {{selectedKey === item.key ? 'on' : ''}} {{item.available ? '' : 'off'}}"
        data-k="{{item.key}}"
        bindtap="pick">
        <view class="rc-head">
          <view class="rc-title-wrap">
            <text class="rc-title serif">{{item.label}}</text>
            <text class="rc-cap">可容纳 {{item.cap}}</text>
          </view>
          <view class="rc-badges">
            <text wx:if="{{item.recommend}}" class="badge-accent">推荐</text>
            <text wx:if="{{item.available}}" class="badge-ok">{{item.leftText || '可预订'}}</text>
            <text wx:else class="badge-full">已订满</text>
          </view>
        </view>
        <view class="divider-dash"></view>
        <view class="rc-foot">
          <text class="rc-right">{{item.desc}}</text>
        </view>
      </view>
    </block>

    <!-- 单间 -->
    <view wx:if="{{singles.length > 0}}" class="opt-label">
      <view class="tick"></view><text class="label-txt serif">独立包间</text>
    </view>
    <view
      wx:for="{{singles}}"
      wx:key="key"
      class="room-card {{selectedKey === item.key ? 'on' : ''}} {{item.available ? '' : 'off'}}"
      data-k="{{item.key}}"
      bindtap="pick">
      <view class="rc-head">
        <view class="rc-title-wrap">
          <text class="rc-title serif">{{item.label}}</text>
          <text class="rc-cap">可容纳 {{item.cap}}</text>
        </view>
        <view class="rc-badges">
          <text wx:if="{{item.recommend}}" class="badge-accent">推荐</text>
          <text wx:if="{{item.hasKtv}}" class="badge-accent">KTV</text>
          <text wx:if="{{item.available}}" class="badge-ok">可预订</text>
          <text wx:else class="badge-full">已订满</text>
        </view>
      </view>
      <view class="divider-dash"></view>
      <view class="rc-foot">
        <text class="rc-right">{{item.desc}}</text>
      </view>
    </view>

  </view>

  <!-- 多人宴请（>20 人需拼间连通）：致电门店预约，不走线上 -->
  <view wx:if="{{needCall}}" class="wait-card floor-in">
    <view class="wc-head">
      <text class="wc-title serif">多人宴请 · 致电预约</text>
    </view>
    <view class="divider-dash"></view>
    <view class="wc-body">
      <text class="wc-desc">{{banner}}：该人数已超过单间最大容纳（20人）。三个小包间隔断可拆卸、拼间连通最多 39 人，席位与菜单需门店专人安排，请直接致电预约。</text>
      <view class="btn-primary wc-btn" hover-class="hover" bindtap="callRestaurant">致电门店 · 021-57772033</view>
    </view>
  </view>

  <!-- 订满兜底：等位回电 + 拼间致电引导 -->
  <view wx:if="{{allFull}}" class="wait-card floor-in">
    <view class="wc-head">
      <text class="wc-title serif">该时段座位已订满</text>
      <text wx:if="{{cbDone}}" class="badge-ok">已登记</text>
    </view>
    <view class="divider-dash"></view>
    <view wx:if="{{!cbDone}}" class="wc-body">
      <text class="wc-desc">留下电话，座位空出时「小乔」将第一时间致电您。</text>
      <view class="btn-primary wc-btn" hover-class="hover" bindtap="openCallback">留电话 · 有位回电</view>
      <view class="wc-call" bindtap="callRestaurant">如需拼间连通或多人宴请，也可直接致电 021-57772033</view>
    </view>
    <view wx:else class="wc-body">
      <text class="wc-desc">已登记 {{cbPhoneMask}}。{{banner}} 座位空出时，我们将致电您，请留意来电。</text>
      <view class="wc-call" bindtap="callRestaurant">如需拼间连通或多人宴请，也可直接致电 021-57772033</view>
    </view>
  </view>

  <view wx:if="{{!allFull && !needCall}}" class="action">
    <view class="btn-primary {{selectedKey ? '' : 'disabled'}}" hover-class="hover" bindtap="confirm">确认选择</view>
  </view>

  <!-- 等位回电表单弹层 -->
  <view wx:if="{{showCallback}}" class="cb-mask" bindtap="closeCallback">
    <view class="cb-panel" catchtap="">
      <view class="cb-title serif">留个电话，有位回电</view>
      <view class="cb-sub">{{banner}}</view>
      <view class="cb-field">
        <text class="cb-label">称呼（选填）</text>
        <input class="cb-input" placeholder="如：张先生 / 李女士" value="{{cbName}}" bindinput="onCbName" />
      </view>
      <view class="cb-field">
        <text class="cb-label">手机号</text>
        <input class="cb-input" type="number" maxlength="11" placeholder="用于接收回电" value="{{cbPhone}}" bindinput="onCbPhone" />
      </view>
      <view class="btn-primary cb-submit {{cbSubmitting ? 'disabled' : ''}}" hover-class="hover" bindtap="submitCallback">{{cbSubmitting ? '登记中…' : '登记等位'}}</view>
      <view class="cb-cancel" bindtap="closeCallback">再想想</view>
    </view>
  </view>
</view>
